                    inset 0 0 14px rgba(255,255,255,0.4),
                    inset 0 -6px 10px rgba(70,30,140,0.65),
                    0 0 18px rgba(210,170,255,0.6);
                border: 1.5px solid rgba(255,255,255,0.55);
                animation: bubbleFloat 2.6s ease-in-out 0.8999999999999999s infinite;
            ">
    <span style="
                    position: relative; z-index: 2;
                    font-weight: 900; font-size: 22px;
                    color: #ffffff;
                    text-shadow:
                        0 0 8px rgba(125,249,255,0.9),
                        0 2px 3px rgba(0,30,80,0.7);
                    letter-spacing: 0;
                ">E</span>
    <span style="
                    position: absolute; top: 6px; left: 9px;
                    width: 10px; height: 6px;
                    background: rgba(255,255,255,0.85);
                    border-radius: 50%;
                    filter: blur(1px);
                    z-index: 3;
                "></span>
</div>

