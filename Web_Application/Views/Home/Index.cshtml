    <style>
        /* Keep foreground content above the fish layer */
        #bubbles-start-overlay > *:not(#fish-layer) {
            position: relative;
            z-index: 1;
        }
      

        50% {
            transform: rotate(8deg);
        }

        }

        .start-fish {
            position: absolute;
            left: -160px;
            will-change: transform;
            filter: drop-shadow(0 3px 8px rgba(0,30,60,0.45));
            opacity: 0.9;
        }

            .start-fish .fish-bob {
                display: inline-block;
                will-change: transform;
            }

            .start-fish svg .tail {
                transform-origin: 100% 50%;
                transform-box: fill-box;
                will-change: transform;
            }

            .start-fish svg .fin {
                transform-origin: 50% 100%;
                transform-box: fill-box;
                will-change: transform;
            }
