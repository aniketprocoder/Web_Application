    <div style="display:flex;gap:32px;margin-bottom:48px;">
        <div class="mode-card" data-mode="letters" style="
                cursor:pointer; user-select:none;
                width: 260px; padding: 30px 24px;
                background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.18) 0%, rgba(74,158,255,0.18) 35%, rgba(10,40,80,0.6) 100%);
                border: 2px solid rgba(125,249,255,0.5);
                border-radius: 22px;
                box-shadow: 0 8px 32px rgba(74,158,255,0.35), inset 0 0 24px rgba(255,255,255,0.08);
                text-align: center;
                display: flex; flex-direction: column;
                transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            ">
            <div style="font-size:64px;margin-bottom:8px;">🔤</div>
            <div style="font-size:30px;font-weight:800;letter-spacing:3px;margin-bottom:6px;">LETTERS</div>
            <div style="font-size:15px;color:rgba(255,255,255,0.75);line-height:1.5;font-weight:500;">
                Single letters in bubbles.<br>
                Start from the home row and unlock the full keyboard.<br>
                Keep fingers on home row!
            </div>
            <div style="margin-top:14px;font-size:13px;letter-spacing:2px;color:#7df9ff;font-weight:700;">BEGINNER · LEVELS 1–11</div>
            <div style="margin-top:auto;padding-top:18px;font-size:12px;letter-spacing:3px;color:#9fb6c4;font-weight:600;">HIT SPACE</div>
        </div>

        <div class="mode-card" data-mode="words" style="
                cursor:pointer; user-select:none;
                width: 260px; padding: 30px 24px;
                background: radial-gradient(circle at 30% 25%, rgba(255,255,255,0.18) 0%, rgba(200,130,255,0.18) 35%, rgba(40,15,80,0.6) 100%);
                border: 2px solid rgba(200,130,255,0.5);
                border-radius: 22px;
                box-shadow: 0 8px 32px rgba(168,85,247,0.3), inset 0 0 24px rgba(255,255,255,0.08);
                text-align: center;
                display: flex; flex-direction: column;
                transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            ">
            <div style="font-size:64px;margin-bottom:8px;">✨</div>
            <div style="font-size:30px;font-weight:800;letter-spacing:3px;margin-bottom:6px;">WORDS</div>
            <div style="font-size:15px;color:rgba(255,255,255,0.75);line-height:1.5;font-weight:500;">
                Type whole words to shatter bubbles.<br>
                Flow-typing, combo chains, full skill ceiling.
            </div>
            <div style="margin-top:14px;font-size:13px;letter-spacing:2px;color:#d4a8ff;font-weight:700;">EXPERT · LEVELS 12–15</div>
            <div style="margin-top:auto;padding-top:18px;font-size:12px;letter-spacing:3px;color:#9fb6c4;font-weight:600;">HIT ENTER</div>
        </div>
    </div>

    <div style="font-size:14px;color:rgba(255,255,255,0.5);font-weight:500;letter-spacing:1px;">tap a mode to dive in</div>

    <style>
        .mode-card:hover {
            transform: translateY(-6px) scale(1.03);
            border-color: rgba(255,255,255,0.85) !important;
            box-shadow: 0 14px 40px rgba(125,249,255,0.45), inset 0 0 28px rgba(255,255,255,0.15) !important;
        }
    </style>
    <style>
        /* Keep foreground content above the fish layer */
        #bubbles-start-overlay > *:not(#fish-layer) {
            position: relative;
            z-index: 1;
        }
     

        .start-fish {
            position: absolute;
            left: -160px;
            will-change: transform;
            filter: drop-shadow(0 3px 8px rgba(0,30,60,0.45));
            opacity: 0.9;
        }

            .start-fish .fish-bob {
                display: inline-block;
                will-change: transform;
            }

            .start-fish svg .tail {
                transform-origin: 100% 50%;
                transform-box: fill-box;
                will-change: transform;
            }

            .start-fish svg .fin {
                transform-origin: 50% 100%;
                transform-box: fill-box;
                will-change: transform;
            }
    </style>
</div> *@

