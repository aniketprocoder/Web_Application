<div class="bubble-letter" style="
                position: relative;
                width: 44px; height: 44px;
                display: flex; align-items: center; justify-content: center;
                border-radius: 50%;
                background:
                    radial-gradient(circle at 32% 28%, rgba(255,255,255,0.85) 0%, rgba(255,255,255,0.25) 18%, rgba(170,120,255,0.35) 50%, rgba(70,30,140,0.65) 100%);
